	(text "RS-485 and power supply have Common GND.\nRS-485 requires ground wire to equalize node\nvoltage differences."
		(exclude_from_sim no)
		(at 15.875 133.096 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2103ab51-9a24-4861-b703-d2ce08bc99a7")
	)
	(text "Regulator in pro-mini, is MIC5205:\n5V@150mA with reverse-current protection\nFilter switching regulator\nfor 5V LDO. Cut 440kHz of switching regulator."
		(exclude_from_sim no)
		(at 13.97 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "392bf744-77f2-43dd-985c-c5c57105798f")
	)
	(text "Solder to have UART\nas communication "
