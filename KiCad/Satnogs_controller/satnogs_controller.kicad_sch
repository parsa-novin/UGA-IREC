		(at 14.478 65.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "39a1ac31-2019-454c-a1d1-cd71682e1ccb")
	)
	(text "Debouncing filter\nfor the mechanichal\nend-stops.\nhttp://wot.lv/combating-endstop-noise-on-a-reprap.html\n"
		(exclude_from_sim no)
		(at 101.6 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
